<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>AllFromZero.Core</Title>
    <Description>AllFromZero.Core是一个通用的C#库，基于.net开发</Description>
    <Copyright>copyright @ AllFromZero 2026</Copyright>
    <PackageProjectUrl>https://github.com/AllFromZero/AllFromZero.Core.git</PackageProjectUrl>
    <PackageIcon>零.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AllFromZero/AllFromZero.Core.git</RepositoryUrl>
    <PackageTags>C#,.net</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Company>AllFromZero</Company>
    <Authors>AllFromZero</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Extensions\" />
    <Folder Include="Exceptions\" />
    <Folder Include="Utils\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Docs\Images\零.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
